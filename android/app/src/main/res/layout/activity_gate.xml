<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="#F0F0F0"
        android:visibility="gone" />

    <!--
        Native loading screen shown over the WebView from the moment a form
        link is tapped until the gate page reports it has rendered. Gives the
        user something to look at while the site + Firebase spin up, and an
        escape hatch (bottom half) that opens the plain form if they'd rather
        not wait or Accord can't load.
    -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080808"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="72dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a."
                android:fontFamily="serif"
                android:textStyle="italic"
                android:textSize="64sp"
                android:textColor="#D9F0F0F0"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/loadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/loading_title"
                android:textSize="14sp"
                android:textColor="#80F0F0F0" />

            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="16dp"
                android:indeterminateTint="#66F0F0F0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingBottom="56dp">

            <Button
                android:id="@+id/bypassBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/proceed_without_accord"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textColor="#B3F0F0F0"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/proceed_without_accord_hint"
                android:textSize="11sp"
                android:textColor="#59F0F0F0"
                android:textAlignment="center" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
