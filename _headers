# Static assets that never change per deploy. HTML/JS/CSS keep Netlify's
# default (max-age=0, must-revalidate) so a deploy is live immediately.
/public/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The Android app's update manifest — keep it short-lived so a new release is
# picked up promptly by the in-app updater.
/app-release.json
  Cache-Control: public, max-age=300

# The APK, served from our own origin. octet-stream (rather than
# application/vnd.android.package-archive) stops some Android download managers
# from trying to hand the file to the package installer mid-download, which is
# what leaves them stuck at 100%.
/download/Accord.apk
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Accord.apk"
  Cache-Control: public, max-age=300
