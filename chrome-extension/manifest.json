{
  "manifest_version": 3,
  "name": "Accord for Google Forms",
  "version": "1.2.0",
  "description": "Auto-fill any Google Form with your verified Google identity through Accord.",
  "homepage_url": "https://accord-ingly.netlify.app",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Accord for Google Forms",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/urbanist-latin.woff2", "fonts/cormorant-mark.woff2"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
